<section id="garantia" class="split">
    <div class="split__text">
        <p class="eyebrow">Por que comprar aqui</p>
        <h2 class="split__title">{{title}}</h2>
        <p class="split__lead">{{text}}</p>
        <ul class="split__points">
            <li>Equipos nuevos y sellados, con factura</li>
            <li>Garantia de 12 meses por defectos de fabrica</li>
            <li>Te configuramos el celular antes de llevartelo</li>
        </ul>
        <a href="#contacto" class="btn btn--light">{{button}}</a>
    </div>
    <img class="split__img" src="{{img}}" alt="{{alt}}">
</section>
